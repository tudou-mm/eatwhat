# 统一换行符，避免 Windows/Linux 协作时 diff 被换行符噪音淹没
* text=auto eol=lf

# 明确按文本处理的文件类型
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.java  text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf

# Windows 脚本保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.jar   binary
*.mp4   binary

# 语言统计时排除
docs/**  linguist-documentation
