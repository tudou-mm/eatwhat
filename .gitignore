# ---------- 环境与凭证（最重要，绝不能提交） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
credentials.json
secrets.yml
application-local.yml
application-prod.yml

# ---------- Java / Maven ----------
server/target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
.settings/
.project
.classpath

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
*.log
logs/
*.tmp
*.bak
*~

# ---------- 测试截图（drive_*.py 产出，本地看效果用） ----------
.shots/
.shots-admin/
.shots-merchant/
.shots-flow/
.shots-v2/

# ---------- 数据库本地文件 ----------
*.db
*.sqlite
*.sqlite3
server/data/

# ---------- 用户上传的媒体（POST /api/upload 落盘到这里，不进仓库） ----------
server/uploads/
uploads/

# ---------- Node（如果以后加前端构建） ----------
node_modules/
dist/
.cache/

# ---------- Python（server/tools 下的脚本跑起来会生成） ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---------- WorkBuddy 本地状态 ----------
.workbuddy/
